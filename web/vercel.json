{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh fetch-firmware.sh && npm install --no-audit --no-fund && node build-docs.mjs && rm -rf node_modules",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/firmware/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "flash.helrig.com"
        }
      ],
      "destination": "https://box.helrig.com/flash",
      "permanent": false
    },
    {
      "source": "/docs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/",
      "destination": "/",
      "permanent": false
    }
  ]
}
